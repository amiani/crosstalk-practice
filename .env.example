# Copy to .env and fill in the keys. Everything else has a working default.

# PostgreSQL (the database must exist; migrations run on startup).
DATABASE_URL=postgres://localhost:5432/crosstalk_practice

# Local-only by default. Set HOST=0.0.0.0 to reach it from a phone on your LAN.
HOST=127.0.0.1
PORT=4280

# Everything model-related goes through OpenRouter.
OPENROUTER_API_KEY=
# Session profiling and sentence writing (any model with structured outputs).
OPENROUTER_MODEL=google/gemini-3.8-flash

# Speech-to-text. "audio-llm" (default) sends audio to a multimodal model,
# which keeps both languages; "stt" uses the transcription endpoint, e.g.
# TRANSCRIBE_MODEL=google/gemini-3.5-transcribe (it tends to drop the English).
TRANSCRIBER=audio-llm
TRANSCRIBE_MODEL=google/gemini-3.8-flash
TRANSCRIBE_CHUNK_SECONDS=180

# Text-to-speech.
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
TTS_VOICE=Kore

# Practice tuning.
PRACTICE_BUFFER_SIZE=6
PRACTICE_BATCH_SIZE=5
# Curriculum sentences kept ahead, and writing jobs run at once.
CURRICULUM_BUFFER_SIZE=10
CURRICULUM_CONCURRENCY=4
MIN_USABLE_UTTERANCES=5
MAX_RECORDING_MINUTES=30

# Uploaded recordings wait here until transcribed, then are deleted.
DATA_DIR=data

# Tests that touch PostgreSQL run only when this is set; they recreate the schema.
# CROSSTALK_TEST_DATABASE_URL=postgres://localhost:5432/crosstalk_practice_test
